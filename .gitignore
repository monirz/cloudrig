# Shadows the parent workspace at ../go.work, which does not list this
# module. Local to this checkout; CI has no parent workspace to shadow.
go.work
go.work.sum

# Build output
/cloudrig
/pubsub
examples/cloudrun/server

# GoReleaser output
/dist

# Working notes and briefs, not part of the published module. UNSUPPORTED.md
# and the docs/ guides are published on purpose; competitive.md is an internal
# brief and stays out.
.claude/
PLAN.md
spec.md
docs/competitive.md

# Node fixtures install their own dependencies.
testdata/**/node_modules/

# gcloud writes this into any directory it deploys from.
.gcloudignore

# Terraform working directory
.terraform/
.terraform.lock.hcl
terraform.tfstate*
